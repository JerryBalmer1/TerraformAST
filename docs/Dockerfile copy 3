FROM mcr.microsoft.com/powershell:latest AS builder

USER root

RUN apt-get update && apt-get install -y \
    git \
    golang-go \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN cd ./src/go && \
    sed -i '/^go /d' go.mod && \
    go mod tidy && \
    go build -o "/PS.Util.Terraform.dll" -buildmode=c-shared .

FROM scratch AS exporter
COPY --from=builder /out/PS.Util.Terraform.dll /PS.Util.Terraform.dll